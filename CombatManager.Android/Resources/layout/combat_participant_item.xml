<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="68dp" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp" android:paddingBottom="10dp">
    <LinearLayout android:id="@+id/combat_row_identity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/combat_row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/combat_row_cr" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
        <TextView android:id="@+id/combat_row_initiative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/combat_row_hp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary_dark" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/combat_row_hp_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <Button android:id="@+id/combat_row_hp_minus" android:layout_width="44dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="−" android:textSize="20sp" android:contentDescription="Decrease current HP" />
            <EditText android:id="@+id/combat_row_hp_value" android:layout_width="58dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:padding="2dp" android:inputType="numberSigned" android:maxLength="5" android:maxLines="1" android:imeOptions="actionDone" android:selectAllOnFocus="true" android:textSize="16sp" android:contentDescription="Current HP" />
            <Button android:id="@+id/combat_row_hp_plus" android:layout_width="44dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="+" android:textSize="20sp" android:contentDescription="Increase current HP" />
            <TextView android:id="@+id/combat_row_hp_maximum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
