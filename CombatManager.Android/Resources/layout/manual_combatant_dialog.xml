<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/combatant_name" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/manual_name" />
    <EditText android:id="@+id/manual_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/combatant_name" android:inputType="textCapWords" android:singleLine="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/maximum_hp" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/manual_hp" />
    <EditText android:id="@+id/manual_hp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/maximum_hp" android:inputType="number" android:singleLine="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/initiative_modifier" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/manual_initiative_modifier" />
    <EditText android:id="@+id/manual_initiative_modifier" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/initiative_modifier" android:inputType="numberSigned" android:singleLine="true" android:text="0" />
</LinearLayout>
