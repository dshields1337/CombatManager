<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\CombatManagerCore.Android\CombatManagerCore.Android.csproj" />
    <AndroidAsset Include="..\CombatManagerCore\BestiaryShort.xml" Link="BestiaryShort.xml" />
    <AndroidAsset Include="..\CombatManagerCore\Bestiary.xml" Link="Bestiary.xml" />
    <AndroidAsset Include="..\CombatManagerCore\Feats.xml" Link="Feats.xml" />
    <AndroidAsset Include="..\CombatManagerCore\SpellsShort.xml" Link="SpellsShort.xml" />
    <AndroidAsset Include="..\CombatManagerCore\Spells.xml" Link="Spells.xml" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.kyleolson.combatmanager</ApplicationId>
    <ApplicationVersion>41</ApplicationVersion>
    <ApplicationDisplayVersion>1.27</ApplicationDisplayVersion>
    <!-- Keep Debug APKs self-contained so they can be installed directly with adb. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>
</Project>
