<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/page_background" android:fitsSystemWindows="true">
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none" android:background="@android:color/white">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
            <Button android:id="@+id/combat_button" style="@style/HomeTab" android:text="@string/combat" />
            <Button android:id="@+id/monsters_button" style="@style/HomeTab" android:text="@string/monsters" />
            <Button android:id="@+id/characters_button" style="@style/HomeTab" android:text="@string/characters" />
            <Button android:id="@+id/encounters_button" style="@style/HomeTab" android:text="@string/encounters" />
            <Button android:id="@+id/feats_button" style="@style/HomeTab" android:text="@string/feats" />
            <Button android:id="@+id/spells_button" style="@style/HomeTab" android:text="@string/spells" />
            <Button android:id="@+id/rules_button" style="@style/HomeTab" android:text="@string/rules" />
            <Button android:id="@+id/treasure_button" style="@style/HomeTab" android:text="@string/treasure" />
        </LinearLayout>
    </HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/combat_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <Button android:id="@+id/combat_sequence_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/combat_sequence" />
                <Button android:id="@+id/combat_party_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party" />
                <Button android:id="@+id/combat_monsters_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/encounter_monsters" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/combat_sequence_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp">
                        <Button android:id="@+id/previous_turn_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/previous_turn" />
                        <TextView android:id="@+id/round_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:gravity="center" android:textColor="@color/text_primary" android:textStyle="bold" />
                        <Button android:id="@+id/next_turn_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/next_turn" />
                    </LinearLayout>
                    <TextView android:id="@+id/combat_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/sequence_empty" android:textColor="@color/text_secondary" android:textSize="17sp" />
                    <ListView android:id="@+id/combat_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
                    <Button android:id="@+id/set_all_initiative_button" android:layout_width="match_parent" android:layout_height="72dp" android:layout_margin="12dp" android:backgroundTint="@color/combat_red" android:text="@string/start_initiative" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/combat_party_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                        <TextView android:id="@+id/combat_party_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" />
                        <Button android:id="@+id/add_combatant_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_party_member" />
                    </LinearLayout>
                    <TextView android:id="@+id/combat_party_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/party_empty" android:textColor="@color/text_secondary" android:textSize="17sp" />
                    <ListView android:id="@+id/combat_party_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:id="@+id/combat_monsters_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/combat_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/text_secondary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                        <Button android:id="@+id/browse_encounter_monsters_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/browse_monsters" />
                        <Button android:id="@+id/name_encounter_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/name_encounter" />
                        <Button android:id="@+id/clear_combat_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/clear_encounter" />
                    </LinearLayout>
                    <TextView android:id="@+id/combat_monsters_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/encounter_monsters_empty" android:textColor="@color/text_secondary" android:textSize="17sp" />
                    <ListView android:id="@+id/combat_monsters_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                        <Button android:id="@+id/save_encounter_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/save_encounter" />
                        <Button android:id="@+id/load_encounter_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/load_encounter" />
                        <Button android:id="@+id/share_encounter_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/share" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/placeholder_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp">
            <TextView android:id="@+id/page_icon" android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:background="@drawable/circle_accent" android:textColor="@android:color/white" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/page_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/page_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/migration_status" android:textColor="@color/text_secondary" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/monsters_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <Button android:id="@+id/monster_bestiary_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bestiary" />
                <Button android:id="@+id/monster_custom_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/custom_monsters" />
            </LinearLayout>
            <LinearLayout android:id="@+id/monster_bestiary_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <SearchView android:id="@+id/monster_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="@string/search_monsters" android:iconifiedByDefault="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="6dp">
                <Spinner android:id="@+id/monster_type_filter" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="@string/filter_by_type" />
                <Spinner android:id="@+id/monster_cr_filter" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="@string/filter_by_cr" />
            </LinearLayout>
            <TextView android:id="@+id/monster_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
                <Button android:id="@+id/select_monsters_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/select_monsters" />
                <Button android:id="@+id/cancel_monster_selection_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@android:string/cancel" android:visibility="gone" />
            </LinearLayout>
            <ProgressBar android:id="@+id/monster_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" />
            <ListView android:id="@+id/monster_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/custom_monsters_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                    <TextView android:id="@+id/saved_monster_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/new_saved_monster_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_monster" />
                </LinearLayout>
                <TextView android:id="@+id/saved_monster_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/no_saved_monsters" android:textColor="@color/text_secondary" android:textSize="17sp" />
                <ListView android:id="@+id/saved_monster_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/characters_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                <TextView android:id="@+id/saved_character_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/new_saved_character_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_character" />
            </LinearLayout>
            <TextView android:id="@+id/saved_character_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/no_saved_characters" android:textColor="@color/text_secondary" android:textSize="17sp" />
            <ListView android:id="@+id/saved_character_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/encounters_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/saved_encounter_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/saved_encounter_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="32dp" android:text="@string/no_saved_encounters" android:textColor="@color/text_secondary" android:textSize="17sp" />
            <ListView android:id="@+id/saved_encounter_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/feats_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <SearchView android:id="@+id/feat_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="@string/search_feats" android:iconifiedByDefault="false" />
            <Spinner android:id="@+id/feat_type_filter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:contentDescription="@string/filter_feats_by_type" />
            <TextView android:id="@+id/feat_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/feat_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" />
            <ListView android:id="@+id/feat_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/spells_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <SearchView android:id="@+id/spell_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="@string/search_spells" android:iconifiedByDefault="false" />
            <Spinner android:id="@+id/spell_school_filter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:contentDescription="@string/filter_spells_by_school" />
            <TextView android:id="@+id/spell_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/spell_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" />
            <ListView android:id="@+id/spell_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rules_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <SearchView android:id="@+id/rule_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="@string/search_rules" android:iconifiedByDefault="false" />
            <Spinner android:id="@+id/rule_type_filter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:contentDescription="@string/filter_rules_by_type" />
            <TextView android:id="@+id/rule_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/rule_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" />
            <ListView android:id="@+id/rule_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/treasure_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <SearchView android:id="@+id/magic_item_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="@string/search_magic_items" android:iconifiedByDefault="false" />
            <Spinner android:id="@+id/magic_item_group_filter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:contentDescription="@string/filter_magic_items_by_group" />
            <TextView android:id="@+id/magic_item_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/magic_item_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" />
            <ListView android:id="@+id/magic_item_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/primary_light" android:dividerHeight="1dp" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
