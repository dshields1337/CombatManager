<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView style="@style/EditorFieldLabel" android:text="@string/combatant_name" android:labelFor="@id/saved_monster_name" />
        <EditText android:id="@+id/saved_monster_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/combatant_name" android:inputType="textCapWords" android:singleLine="true" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/maximum_hp" android:labelFor="@id/saved_monster_hp" />
        <EditText android:id="@+id/saved_monster_hp" style="@style/MonsterNumberField" android:hint="@string/maximum_hp" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/armor_class" android:labelFor="@id/saved_monster_ac" />
        <EditText android:id="@+id/saved_monster_ac" style="@style/MonsterNumberField" android:hint="@string/armor_class" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/touch_ac" android:labelFor="@id/saved_monster_touch_ac" />
        <EditText android:id="@+id/saved_monster_touch_ac" style="@style/MonsterNumberField" android:hint="@string/touch_ac" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/flat_footed_ac" android:labelFor="@id/saved_monster_flat_footed_ac" />
        <EditText android:id="@+id/saved_monster_flat_footed_ac" style="@style/MonsterNumberField" android:hint="@string/flat_footed_ac" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/cmd" android:labelFor="@id/saved_monster_cmd" />
        <EditText android:id="@+id/saved_monster_cmd" style="@style/MonsterNumberField" android:hint="@string/cmd" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/cmb" android:labelFor="@id/saved_monster_cmb" />
        <EditText android:id="@+id/saved_monster_cmb" style="@style/MonsterSignedNumberField" android:hint="@string/cmb" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/initiative_modifier" android:labelFor="@id/saved_monster_initiative_modifier" />
        <EditText android:id="@+id/saved_monster_initiative_modifier" style="@style/MonsterSignedNumberField" android:hint="@string/initiative_modifier" />
        <TextView style="@style/EditorFieldLabel" android:text="@string/notes" android:labelFor="@id/saved_monster_notes" />
        <EditText android:id="@+id/saved_monster_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="@string/monster_notes_optional" android:inputType="textCapSentences|textMultiLine" android:minLines="3" />
    </LinearLayout>
</ScrollView>
