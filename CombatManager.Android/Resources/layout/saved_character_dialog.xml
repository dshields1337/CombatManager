<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/combatant_name" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/saved_character_name" />
        <EditText android:id="@+id/saved_character_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/combatant_name" android:inputType="textCapWords" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/maximum_hp" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/saved_character_hp" />
        <EditText android:id="@+id/saved_character_hp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/maximum_hp" android:inputType="number" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/initiative_modifier" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/saved_character_initiative_modifier" />
        <EditText android:id="@+id/saved_character_initiative_modifier" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/initiative_modifier" android:inputType="numberSigned" android:singleLine="true" android:text="0" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/notes" android:textColor="@color/text_primary" android:textStyle="bold" android:labelFor="@id/saved_character_notes" />
        <EditText android:id="@+id/saved_character_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="@string/character_notes_optional" android:inputType="textCapSentences|textMultiLine" android:minLines="3" />
    </LinearLayout>
</ScrollView>
